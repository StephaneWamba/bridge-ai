# HubSpot OAuth Credentials
HUBSPOT_CLIENT_ID=your_hubspot_client_id_here
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret_here
HUBSPOT_REDIRECT_URI=http://localhost:8001/api/v1/integrations/hubspot/callback

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/integrations/google/callback

# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/bridgeai
LANGRAPH_CHECKPOINT_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bridgeai_checkpoints

# Security (MUST change in production - generate secure random keys)
SECRET_KEY=generate_random_secret_key_minimum_32_characters_long
ENCRYPTION_KEY=generate_random_32_character_encryption_key

# Debug
DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3004